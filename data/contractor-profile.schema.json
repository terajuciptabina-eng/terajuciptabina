{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teraju-contractor-profile-v1",
  "title": "Teraju Contractor Profile",
  "type": "object",
  "required": ["contractorId", "contractorName", "state"],
  "properties": {
    "contractorId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable contractor identifier. This is the primary key for contractor-owned data."
    },
    "contractorName": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
        "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak",
        "Selangor", "Terengganu", "Kuala Lumpur", "Putrajaya", "Labuan"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
